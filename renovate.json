{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "labels": [
    "dependencies"
  ],
  "pre-commit": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Tool versions annotated with '# renovate:' comments in .pre-commit-config.yaml",
      "managerFilePatterns": [
        "/^\\.pre-commit-config\\.yaml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+- --hook-config=--tool-version=(?<currentValue>\\S+)"
      ]
    },
    {
      "customType": "regex",
      "description": "terraform-linters/tflint version in the Makefile",
      "managerFilePatterns": [
        "/^Makefile$/"
      ],
      "matchStrings": [
        "TFLINT_VERSION\\s*:=\\s*(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "terraform-linters/tflint"
    },
    {
      "customType": "regex",
      "description": "terraform-docs/terraform-docs version in the Makefile",
      "managerFilePatterns": [
        "/^Makefile$/"
      ],
      "matchStrings": [
        "TFDOCS_VERSION\\s*:=\\s*(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "terraform-docs/terraform-docs"
    }
  ],
  "packageRules": [
    {
      "matchManagers": [
        "custom.regex"
      ],
      "matchDatasources": [
        "github-releases"
      ],
      "extractVersion": "^v(?<version>.*)$"
    },
    {
      "description": "Group non-major updates into one PR",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pinDigest"
      ],
      "groupName": "non-major dependencies"
    }
  ]
}
